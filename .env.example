# --- data source (required) -------------------------------------------------
# Free token: travelpayouts.com -> sign up -> Developers -> API tokens
TRAVELPAYOUTS_TOKEN=
# Optional affiliate marker; appended to booking links if set.
TRAVELPAYOUTS_MARKER=

CURRENCY=usd
# Only used by the cold-start distance heuristic. Leave unset for
# usd/eur/ils/gbp/rub — reasonable defaults are built in.
# USD_RATE=3.7

# --- where state lives --------------------------------------------------------
DATA_DIR=./data
WATCHLIST_FILE=watchlist.toml
KEEP_HISTORY_DAYS=365

# --- public website (optional) -----------------------------------------------
# When SITE_BUCKET is set, each scan uploads the results as JSON for the
# static frontend to read. Use the narrow flight-radar-publisher credentials,
# not an admin key: the policy allows PutObject on data/* and nothing else.
SITE_BUCKET=
SITE_DATA_KEY=data/deals.json
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1

# --- notifications (configure at least one) ----------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# --- detection tuning ---------------------------------------------------------
# Raise MIN_DROP_PCT / MIN_Z_SCORE for fewer, louder alerts.
BASELINE_WINDOW_DAYS=90
MIN_OBSERVATIONS=12
MIN_DISTINCT_DAYS=6
MIN_DROP_PCT=0.35
# The main volume knob. 2.5 gives roughly 7 background alerts a week across
# 60 destinations, 3.0 gives about 3, 3.5 about 1.
MIN_Z_SCORE=3.0
ERROR_FARE_DROP_PCT=0.70
# How far below the distance-based expectation a fare must be when the route
# has no history yet.
COLD_START_RATIO=0.45

# --- alert volume -------------------------------------------------------------
ALERT_COOLDOWN_HOURS=48
ALERT_IMPROVE_PCT=0.15
MAX_ALERTS_PER_SCAN=6
SCAN_INTERVAL_MINUTES=180
