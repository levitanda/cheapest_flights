[Unit]
Description=Flight Deal Radar
Documentation=https://github.com/levitanda/cheapest_flights
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# bootstrap.sh rewrites these two to whoever ran the deploy.
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/cheapest_flights
EnvironmentFile=/opt/cheapest_flights/.env
ExecStart=/opt/cheapest_flights/.venv/bin/python -m flight_radar watch

# The scan loop survives its own errors, so a restart here means the process
# died outright — back off rather than spin.
Restart=always
RestartSec=60

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=flight-radar

[Install]
WantedBy=multi-user.target
